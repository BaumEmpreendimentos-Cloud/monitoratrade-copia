{
  "name": "Operacao",
  "type": "object",
  "properties": {
    "grupo_id": {
      "type": "string",
      "title": "Grupo"
    },
    "grupo_nome": {
      "type": "string",
      "title": "Identificador"
    },
    "ativo": {
      "type": "string",
      "title": "Ativo",
      "minLength": 4,
      "maxLength": 8
    },
    "ativo_base": {
      "type": "string",
      "title": "Ativo base (underlying)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "ACAO",
        "CALL",
        "PUT",
        "DOLLAR",
        "FII"
      ],
      "default": "ACAO"
    },
    "operacao": {
      "type": "string",
      "enum": [
        "COMPRA",
        "VENDA"
      ],
      "default": "COMPRA"
    },
    "quantidade": {
      "type": "number",
      "minimum": 0
    },
    "preco_entrada": {
      "type": "number"
    },
    "valor_inicial": {
      "type": "number"
    },
    "data_abertura": {
      "type": "string",
      "format": "date"
    },
    "strike": {
      "type": "number",
      "title": "Strike"
    },
    "vencimento": {
      "type": "string",
      "format": "date",
      "title": "Vencimento"
    },
    "status": {
      "type": "string",
      "enum": [
        "ABERTA",
        "FECHADA"
      ],
      "default": "ABERTA"
    },
    "preco_fechamento": {
      "type": "number"
    },
    "resultado_valor": {
      "type": "number"
    },
    "resultado_pct": {
      "type": "number"
    },
    "data_fechamento": {
      "type": "string",
      "format": "date-time"
    },
    "irrf": {
      "type": "number",
      "default": 0,
      "title": "IRRF retido na fonte"
    },
    "simulada": {
      "type": "boolean",
      "default": false,
      "title": "Opera\u00e7\u00e3o simulada (acompanhamento)"
    }
  },
  "required": [
    "grupo_id",
    "grupo_nome",
    "ativo",
    "categoria",
    "operacao",
    "quantidade",
    "preco_entrada"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}