{
  "name": "Indicacao",
  "type": "object",
  "properties": {
    "indicado_por_id": {
      "type": "string",
      "title": "ID do indicador"
    },
    "indicado_por_email": {
      "type": "string",
      "title": "Email do indicador"
    },
    "user_id": {
      "type": "string",
      "title": "ID do usu\u00e1rio indicado"
    },
    "user_email": {
      "type": "string",
      "title": "Email do usu\u00e1rio indicado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "convertido"
      ],
      "default": "pendente",
      "title": "Status"
    },
    "recompensa_aplicada": {
      "type": "boolean",
      "default": false,
      "title": "Recompensa aplicada"
    },
    "beneficio_dias": {
      "type": "number",
      "default": 30,
      "title": "Benef\u00edcio em dias"
    },
    "data_indicacao": {
      "type": "string",
      "format": "date-time",
      "title": "Data da indica\u00e7\u00e3o"
    },
    "data_conversao": {
      "type": "string",
      "format": "date-time",
      "title": "Data da convers\u00e3o"
    }
  },
  "required": [
    "indicado_por_id",
    "user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.indicado_por_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}