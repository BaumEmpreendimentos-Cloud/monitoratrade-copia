{
  "name": "ApuracaoMensal",
  "type": "object",
  "properties": {
    "mes": {
      "type": "string",
      "title": "M\u00eas (YYYY-MM)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "ACOES",
        "OPCOES",
        "FII",
        "FUTUROS",
        "GERAL"
      ],
      "default": "GERAL",
      "title": "Categoria"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "SWING",
        "DAY_TRADE"
      ],
      "title": "Tipo de opera\u00e7\u00e3o"
    },
    "resultado_bruto": {
      "type": "number",
      "default": 0,
      "title": "Resultado bruto"
    },
    "irrf": {
      "type": "number",
      "default": 0,
      "title": "IRRF retido"
    },
    "prejuizo_compensado": {
      "type": "number",
      "default": 0,
      "title": "Preju\u00edzo compensado"
    },
    "prejuizo_acumulado_final": {
      "type": "number",
      "default": 0,
      "title": "Preju\u00edzo acumulado final"
    },
    "aliquota": {
      "type": "number",
      "title": "Al\u00edquota aplicada"
    },
    "imposto_devido": {
      "type": "number",
      "default": 0,
      "title": "Imposto devido"
    },
    "imposto_pagar": {
      "type": "number",
      "default": 0,
      "title": "Imposto a pagar"
    },
    "darf_gerada": {
      "type": "boolean",
      "default": false,
      "title": "DARF gerada"
    },
    "data_geracao_darf": {
      "type": "string",
      "format": "date-time",
      "title": "Data de gera\u00e7\u00e3o da DARF"
    },
    "aceite_responsabilidade": {
      "type": "boolean",
      "default": false,
      "title": "Aceite de responsabilidade"
    },
    "pago": {
      "type": "boolean",
      "default": false,
      "title": "Pago"
    },
    "data_pagamento": {
      "type": "string",
      "format": "date-time",
      "title": "Data de pagamento"
    }
  },
  "required": [
    "mes",
    "tipo"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}