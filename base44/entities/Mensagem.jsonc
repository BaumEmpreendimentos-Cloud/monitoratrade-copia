{
  "name": "Mensagem",
  "type": "object",
  "properties": {
    "para_id": {
      "type": "string",
      "title": "Destinat\u00e1rio (id do usu\u00e1rio, ALL ou GESTOR)"
    },
    "para_nome": {
      "type": "string",
      "title": "Nome do destinat\u00e1rio"
    },
    "texto": {
      "type": "string",
      "title": "Mensagem"
    }
  },
  "required": [
    "para_id",
    "texto"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.para_id": "{{user.id}}"
        },
        {
          "data.para_id": "ALL"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}