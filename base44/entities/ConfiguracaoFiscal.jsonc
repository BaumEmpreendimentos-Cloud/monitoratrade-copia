{
  "name": "ConfiguracaoFiscal",
  "type": "object",
  "properties": {
    "mes_inicio": {
      "type": "string",
      "title": "M\u00eas inicial de apura\u00e7\u00e3o (YYYY-MM)"
    },
    "prejuizo_swing": {
      "type": "number",
      "default": 0,
      "title": "Preju\u00edzo acumulado (swing trade)"
    },
    "prejuizo_dt": {
      "type": "number",
      "default": 0,
      "title": "Preju\u00edzo acumulado (day trade)"
    },
    "impostos_anteriores_recolhidos": {
      "type": "boolean",
      "default": false,
      "title": "Impostos anteriores recolhidos"
    },
    "onboarding_completo": {
      "type": "boolean",
      "default": false,
      "title": "Onboarding conclu\u00eddo"
    }
  },
  "required": [
    "mes_inicio",
    "onboarding_completo"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}